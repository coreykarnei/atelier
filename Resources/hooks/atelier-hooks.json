{
  "//": "Merge these hook entries into the top-level hooks object in ~/.claude/settings.json, preserving existing settings and hooks. This example assumes make install has linked Atelier.app into /Applications. Update every helper path if the app lives elsewhere. See docs/SETUP.md.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/Atelier.app/Contents/MacOS/atelier-notify stop"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/Atelier.app/Contents/MacOS/atelier-notify blocked"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/Atelier.app/Contents/MacOS/atelier-notify waiting"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/Atelier.app/Contents/MacOS/atelier-notify working"
          }
        ]
      }
    ]
  }
}
